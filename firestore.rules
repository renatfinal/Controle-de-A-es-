rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for Transaction
    function isValidTransaction(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && data.id is number
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 120
        && data.ticker is string && data.ticker.size() > 0 && data.ticker.size() <= 16 && data.ticker.matches('^[A-Z0-9]+$')
        && data.classe in ['Ação', 'FII', 'BDR', 'ETF', 'Renda Fixa', 'Outros']
        && data.tipo in ['ENTRADA', 'SAIDA', 'DIVIDENDO']
        && data.accountMode in ['real', 'demo']
        && data.qtd is number && data.qtd >= 0
        && data.valorUn is number && data.valorUn >= 0
        && data.valorTotal is number && data.valorTotal >= 0
        && data.dividendo is number && data.dividendo >= 0
        && (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 500));
    }

    // Validation for User Profile
    function isValidProfile(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('nome' in data) || (data.nome is string && data.nome.size() <= 100))
        && (!('telefone' in data) || (data.telefone is string && data.telefone.size() <= 25));
    }

    // Connectivity test path (mandated by skill for getDocFromServer test)
    match /test/{testId} {
      allow get: if true;
    }

    // User transactions subcollection
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId) && isValidId(transactionId);
      allow list: if isOwner(userId);
      allow delete: if isOwner(userId) && isValidId(transactionId);

      allow create: if isOwner(userId)
        && isValidId(transactionId)
        && isValidTransaction(incoming(), userId)
        && incoming().keys().hasAll(['id', 'date', 'nome', 'ticker', 'classe', 'qtd', 'valorUn', 'valorTotal', 'tipo', 'dividendo', 'userId', 'accountMode'])
        && incoming().keys().hasOnly(['id', 'date', 'nome', 'ticker', 'classe', 'qtd', 'valorUn', 'valorTotal', 'tipo', 'dividendo', 'userId', 'accountMode', 'observacoes']);

      allow update: if isOwner(userId)
        && isValidId(transactionId)
        && isValidTransaction(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'nome', 'ticker', 'classe', 'qtd', 'valorUn', 'valorTotal', 'tipo', 'dividendo', 'observacoes', 'accountMode']);
    }

    // User profile document
    match /users/{userId}/profile/{profileId} {
      allow get: if isOwner(userId) && isValidId(profileId);
      allow list: if isOwner(userId);
      allow delete: if isOwner(userId) && isValidId(profileId);

      allow create: if isOwner(userId)
        && isValidId(profileId)
        && isValidProfile(incoming(), userId)
        && incoming().keys().hasAll(['userId', 'email'])
        && incoming().keys().hasOnly(['userId', 'email', 'nome', 'telefone']);

      allow update: if isOwner(userId)
        && isValidId(profileId)
        && isValidProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'nome', 'telefone']);
    }
  }
}
